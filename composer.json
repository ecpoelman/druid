{
    "name": "druid/druid",
    "description": "druid - a command line shell and Unix scripting interface for upgrading Drupal core and contrib modules.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": ["drupal", "drush", "upgrade", "security", "composer", "cli"],
    "homepage": "https://github.com/druid/druid",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-simplexml": "*",
        "composer/semver": "^3.3",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Druid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Druid\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/druid"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
